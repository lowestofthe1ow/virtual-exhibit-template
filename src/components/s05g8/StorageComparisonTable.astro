<section class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Device</th>
        <th>Storage Method</th>
        <th>Main Advantage</th>
        <th>Main Limitation</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Punch cards / Paper tape</td>
        <td>Punched holes</td>
        <td>Machine-readable physical data</td>
        <td>Very low capacity</td>
      </tr>
      <tr>
        <td>Magnetic tape</td>
        <td>Magnetic patterns on tape</td>
        <td>Good for large backups</td>
        <td>Sequential access</td>
      </tr>
      <tr>
        <td>Hard disk drive</td>
        <td>Magnetic spinning platters</td>
        <td>Large random-access storage</td>
        <td>Mechanical wear and shock sensitivity</td>
      </tr>
      <tr>
        <td>Floppy disk</td>
        <td>Flexible magnetic disk</td>
        <td>Portable file transfer</td>
        <td>Small capacity</td>
      </tr>
      <tr>
        <td>Optical disc</td>
        <td>Laser-read disc surface</td>
        <td>Cheap media distribution</td>
        <td>Scratch-prone and slower</td>
      </tr>
      <tr>
        <td>Flash / Memory card</td>
        <td>Non-volatile memory cells</td>
        <td>Small and shock-resistant</td>
        <td>Limited write endurance</td>
      </tr>
      <tr>
        <td>USB flash drive</td>
        <td>Flash memory with USB interface</td>
        <td>Convenient plug-and-play transfer</td>
        <td>Easy to lose; speed varies</td>
      </tr>
      <tr>
        <td>Solid-state drive</td>
        <td>Flash chips and controller</td>
        <td>Very fast and durable</td>
        <td>Higher cost per GB than HDD</td>
      </tr>
      <tr>
        <td>Cloud storage</td>
        <td>Remote servers over a network</td>
        <td>Accessible and scalable</td>
        <td>Depends on internet and service reliability</td>
      </tr>
    </tbody>
  </table>
</section>
