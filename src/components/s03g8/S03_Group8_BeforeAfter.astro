    <!-- YIELD FORMULA -->
    <div class="formula-box">
        <span class="formula-label"
            >Yield = (1 + (Defects × Area) / α)<sup>−α</sup></span
        >
        <span class="formula-explanation"
            >As die area increases, yield drops exponentially</span
        >
    </div>

