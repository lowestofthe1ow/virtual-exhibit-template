---
import '../../styles/s02g5/global.css';
import EraSwitcher from './EraSwitcher.jsx';

const { frontmatter, url } = Astro.props;
const accentColor = frontmatter?.accentColor || '#66fcf1';
const surfaceColor = frontmatter?.surfaceColor || '#1f2833';

const base = import.meta.env.BASE_URL;

// Original (standalone-hosted) logic assumed the exhibit lived at the site
// root, so the era name was always exactly one segment after the base. Once
// merged, every route gains an extra "s02g5" segment ahead of the era, so
// the era (when present) is always the LAST path segment instead of a fixed
// index. The entry page's last segment is "s02g5" itself, which means "no
// era" (same as the original's own root-page case).
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const lastSegment = pathSegments[pathSegments.length - 1];
const currentEra = lastSegment && lastSegment !== 's02g5' ? lastSegment : '';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter?.title || "From Pixels to Polygons"}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Press+Start+2P&display=swap" rel="stylesheet">
    <style define:vars={{ accentColor, surfaceColor }}>
      :root {
        --neon-accent: var(--accentColor);
        --neon-secondary: var(--surfaceColor);
      }
    </style>
  </head>
  <body class="crt-effect arcade-env">
    <main class="arcade-cabinet">
      <!-- Top Nav Bar -->
      <nav class="exhibit-nav">
        <!-- Home Button link using base (site root, matches the umbrella's shared header convention) -->
        <a href={base} class="home-coin-btn">◀ INSERT COIN / MAIN MENU</a>
        <span class="nav-system-tag">CSARCH2 EXHIBIT</span>
      </nav>

      <div class="mdx-content-wrapper">
        <slot />
      </div>

      {currentEra && currentEra !== '' && <EraSwitcher currentEra={currentEra} client:load />}
    </main>

    <style>
      body.arcade-env {
        background-color: #0b0f19;
        color: #e0e6ed;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
      }

      .arcade-cabinet {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      .exhibit-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px dashed rgba(102, 252, 241, 0.3);
      }

      .home-coin-btn {
        font-family: 'Press Start 2P', monospace;
        font-size: 0.6rem;
        background: rgba(102, 252, 241, 0.1);
        color: var(--neon-accent, #66fcf1);
        padding: 0.6rem 1rem;
        border: 2px solid var(--neon-accent, #66fcf1);
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 0 10px rgba(102, 252, 241, 0.1);
      }

      .home-coin-btn:hover {
        background: var(--neon-accent, #66fcf1);
        color: #000;
        box-shadow: 0 0 20px var(--neon-accent, #66fcf1);
        transform: translateY(-2px);
      }

      .nav-system-tag {
        font-family: 'Press Start 2P', monospace;
        font-size: 0.5rem;
        color: #666;
        letter-spacing: 1px;
      }

      .mdx-content-wrapper {
        line-height: 1.6;
      }
    </style>
  </body>
</html>
