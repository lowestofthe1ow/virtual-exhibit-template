---
import { Icon } from 'astro-icon/components';

const { exhibit } = Astro.props;
const { slug, section, group, title, authors, description, keywords, repo, url } =
  exhibit;

const baseUrl = import.meta.env.BASE_URL;
---

<article class="card" id={slug}>
  <p class="card__tag">{section} &middot; Group {group}</p>

  <h3 class="card__title">
    <a href=`${baseUrl}/${slug}` target="_blank">
      {title}<Icon name="ic:baseline-open-in-new" class="card__ico" />
    </a>
  </h3>

  <p class="card__authors">{authors.join(' · ')}</p>
  <p class="card__desc">{description}</p>

  <ul class="card__keywords">
    {keywords.map((keyword) => <li class="chip">{keyword}</li>)}
  </ul>

  <p class="card__foot">
    <a class="card__repo" href={repo} target="_blank" rel="noopener noreferrer">
      <Icon name="ic:baseline-code" /> Repository
    </a>
  </p>
</article>
