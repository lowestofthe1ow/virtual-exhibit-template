---
// comment 3: interactive "shrink the wavelength" toy for the optical page.
// drag the slider -> pits shrink, density climbs, capacity grows. numbers are
// interpolated from the real CD/DVD/Blu-ray anchor points so it stays honest.
---

<div class="wl" data-wl>
  <div class="wl-head">
    <p class="wl-title">SHRINK THE WAVELENGTH</p>
    <p class="wl-sub">drag the laser shorter and watch the disc hold more</p>
  </div>

  <div class="wl-slider-wrap">
    <input type="range" min="380" max="800" step="1" value="780" class="wl-range" data-wl-range
      aria-label="Laser wavelength in nanometres" />
    <div class="wl-ticks">
      <span data-wl-jump="405">Blu-ray&nbsp;405</span>
      <span data-wl-jump="650">DVD&nbsp;650</span>
      <span data-wl-jump="780">CD&nbsp;780</span>
    </div>
  </div>

  <div class="wl-readout">
    <div class="wl-stat">
      <span class="wl-stat-label">WAVELENGTH</span>
      <span class="wl-stat-val"><b data-wl-nm>780</b> nm</span>
      <span class="wl-swatch" data-wl-swatch></span>
    </div>
    <div class="wl-stat">
      <span class="wl-stat-label">MIN. PIT SIZE</span>
      <span class="wl-stat-val"><b data-wl-pit>833</b> nm</span>
    </div>
    <div class="wl-stat">
      <span class="wl-stat-label">AREAL DENSITY</span>
      <span class="wl-stat-val"><b data-wl-density>1.0</b>&times;</span>
    </div>
    <div class="wl-stat">
      <span class="wl-stat-label">CAPACITY</span>
      <span class="wl-stat-val wl-cap"><b data-wl-cap>0.7</b> <span data-wl-capunit>GB</span></span>
    </div>
  </div>

  <div class="wl-bar-track"><div class="wl-bar-fill" data-wl-bar></div></div>

  <p class="wl-track-label">SAME STRETCH OF TRACK &mdash; pits pack tighter as the laser shrinks</p>
  <canvas class="wl-canvas" data-wl-canvas height="54"></canvas>

  <p class="wl-note" data-wl-note>
    A laser can only resolve features about half its wavelength wide, so a shorter beam
    carves smaller pits &mdash; and smaller pits mean more of them per disc.
  </p>
</div>

<style>
  .wl {
    background: rgba(10, 0, 20, 0.8);
    border: 1px solid rgba(255, 0, 255, 0.25);
    border-radius: 10px;
    padding: 1.5rem 1.5rem 1.75rem;
    margin: 1.5rem 0;
  }
  .wl-title {
    font-family: var(--font-head);
    font-size: 1rem;
    letter-spacing: 2px;
    color: var(--accent-magenta);
  }
  .wl-sub { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.35rem; letter-spacing: 0.5px; }

  .wl-slider-wrap { margin: 1.5rem 0 0.25rem; }
  .wl-range {
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    border-radius: 999px;
    /* long wavelength (right) = red, short (left) = violet */
    background: linear-gradient(90deg, #8a2be2, #4169ff, #39ff14, #ffe600, #ff8c00, #ff2d2d);
    outline: none;
    cursor: pointer;
  }
  .wl-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px; height: 20px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--accent-cyan);
    box-shadow: 0 0 12px rgba(0, 255, 255, 0.7);
    cursor: pointer;
  }
  .wl-range::-moz-range-thumb {
    width: 20px; height: 20px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--accent-cyan);
    box-shadow: 0 0 12px rgba(0, 255, 255, 0.7);
    cursor: pointer;
  }
  .wl-ticks {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.5px;
    color: var(--text-muted);
  }
  .wl-ticks span { cursor: pointer; transition: color 0.2s; }
  .wl-ticks span:hover { color: var(--accent-cyan); }

  .wl-readout {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin: 1.5rem 0 1rem;
  }
  .wl-stat {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 6px;
    padding: 0.7rem 0.6rem;
    text-align: center;
    position: relative;
  }
  .wl-stat-label {
    display: block;
    font-size: 0.6rem;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }
  .wl-stat-val { font-family: var(--font-head); font-size: 1rem; color: var(--accent-cyan); }
  .wl-stat-val b { font-weight: normal; }
  .wl-cap b { color: var(--accent-green); }
  .wl-swatch {
    display: block;
    height: 4px;
    border-radius: 2px;
    margin-top: 0.5rem;
    background: #ff2d2d;
    transition: background 0.15s;
  }

  .wl-bar-track {
    height: 14px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }
  .wl-bar-fill {
    height: 100%;
    width: 12%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent-cyan), var(--accent-green));
    box-shadow: 0 0 12px rgba(57, 255, 20, 0.5);
    transition: width 0.2s ease;
  }

  .wl-track-label {
    font-size: 0.68rem;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin: 1.5rem 0 0.5rem;
  }
  .wl-canvas {
    width: 100%;
    height: 54px;
    display: block;
    border-radius: 6px;
    background: #05000f;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wl-note {
    font-size: 0.8rem;
    color: rgba(170, 170, 204, 0.7);
    line-height: 1.7;
    margin-top: 1rem;
    border-left: 2px solid rgba(255, 0, 255, 0.35);
    padding-left: 0.75rem;
  }

  @media (max-width: 560px) {
    .wl-readout { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.querySelectorAll('[data-wl]').forEach((wl) => {
    const range = wl.querySelector('[data-wl-range]');
    const nmEl = wl.querySelector('[data-wl-nm]');
    const pitEl = wl.querySelector('[data-wl-pit]');
    const densEl = wl.querySelector('[data-wl-density]');
    const capEl = wl.querySelector('[data-wl-cap]');
    const capUnit = wl.querySelector('[data-wl-capunit]');
    const bar = wl.querySelector('[data-wl-bar]');
    const swatch = wl.querySelector('[data-wl-swatch]');
    const note = wl.querySelector('[data-wl-note]');
    const canvas = wl.querySelector('[data-wl-canvas]');
    const ctx = canvas.getContext('2d');

    // real-ish anchor points: [wavelength nm, min pit nm, capacity GB]
    const ANCHORS = [
      [800, 900, 0.6],
      [780, 833, 0.7],   // CD
      [650, 400, 4.7],   // DVD
      [405, 149, 25],    // Blu-ray
      [380, 130, 29],
    ];

    // piecewise-linear interpolation over the anchors (they descend by wavelength)
    function interp(nm, idx) {
      const a = ANCHORS;
      if (nm >= a[0][0]) return a[0][idx];
      if (nm <= a[a.length - 1][0]) return a[a.length - 1][idx];
      for (let i = 0; i < a.length - 1; i++) {
        const hi = a[i], lo = a[i + 1];
        if (nm <= hi[0] && nm >= lo[0]) {
          const t = (nm - lo[0]) / (hi[0] - lo[0]);
          return lo[idx] + t * (hi[idx] - lo[idx]);
        }
      }
      return a[0][idx];
    }

    // rough visible-light colour for a wavelength; infrared fades to dark red
    function nmToColor(nm) {
      let r = 0, g = 0, b = 0;
      if (nm < 440) { r = -(nm - 440) / 60; b = 1; }
      else if (nm < 490) { g = (nm - 440) / 50; b = 1; }
      else if (nm < 510) { g = 1; b = -(nm - 510) / 20; }
      else if (nm < 580) { r = (nm - 510) / 70; g = 1; }
      else if (nm < 645) { r = 1; g = -(nm - 645) / 65; }
      else { r = 1; }
      let f = 1;
      if (nm > 700) f = Math.max(0.3, 1 - (nm - 700) / 150); // infrared dimming
      const to = (v) => Math.round(255 * Math.min(1, Math.max(0, v)) * f);
      return `rgb(${to(r)}, ${to(g)}, ${to(b)})`;
    }

    function drawTrack(pitNm, color) {
      const w = canvas.clientWidth;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = w * dpr;
      canvas.height = 54 * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, 54);

      // pit width on screen scales with real pit size (CD 833nm -> ~24px)
      const pitPx = Math.max(2.2, (pitNm / 833) * 24);
      const gap = pitPx * 0.7;
      const unit = pitPx + gap;
      const y = 27;
      let x = 6;
      let i = 0;
      while (x < w - 6) {
        const isPit = i % 2 === 0;
        if (isPit) {
          ctx.fillStyle = color;
          ctx.shadowColor = color;
          ctx.shadowBlur = 6;
          ctx.fillRect(x, y - 8, pitPx, 16);
          ctx.shadowBlur = 0;
        }
        x += unit;
        i++;
      }
    }

    function update() {
      const nm = +range.value;
      const pit = interp(nm, 1);
      const cap = interp(nm, 2);
      const density = Math.pow(833 / pit, 2); // areal density vs CD
      const color = nmToColor(nm);

      nmEl.textContent = nm;
      pitEl.textContent = Math.round(pit);
      densEl.textContent = density < 10 ? density.toFixed(1) : Math.round(density);
      if (cap >= 1) { capEl.textContent = cap.toFixed(1); capUnit.textContent = 'GB'; }
      else { capEl.textContent = Math.round(cap * 1000); capUnit.textContent = 'MB'; }

      // log-scaled capacity bar (0.5 GB -> ~0%, 30 GB -> 100%)
      const pct = ((Math.log(cap) - Math.log(0.5)) / (Math.log(30) - Math.log(0.5))) * 100;
      bar.style.width = Math.max(4, Math.min(100, pct)) + '%';
      swatch.style.background = color;

      note.textContent = nm > 700
        ? 'At ' + nm + ' nm you\'re in infrared, like a CD — big pits, least data. Drag shorter (toward violet) to pack in more.'
        : 'A laser resolves features about half its wavelength wide, so a shorter beam carves smaller pits — and smaller pits mean more of them per disc.';
      drawTrack(pit, color);
    }

    range.addEventListener('input', update);
    wl.querySelectorAll('[data-wl-jump]').forEach((t) => {
      t.addEventListener('click', () => {
        range.value = t.getAttribute('data-wl-jump');
        update();
      });
    });
    window.addEventListener('resize', update);
    update();
  });
</script>
