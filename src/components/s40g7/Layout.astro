---
// src/layouts/BaseLayout.astro
import '../../styles/s40g7/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props.frontmatter ?? Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Texture Filtering Exhibit</title>
  </head>
  <body>
    <div class="exhibit-topbar">
      <span>Computer Architecture Virtual Exhibit</span>
    </div>

    <div class="container exhibit-container">
      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>Computer Architecture is Forever | Virtual Museum Exhibit 2026</p>
      </footer>
    </div>
  </body>
</html>
