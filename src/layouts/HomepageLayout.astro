---
import 'normalize.css';
import '@fontsource-variable/lora';
import '@fontsource-variable/noto-sans';
import '../styles/global.css';
import '../styles/homepage.css';

import ExhibitCard from '../components/ExhibitCard.astro';
import exhibits from '../data/exhibits.json';

// Try showing first 5 for now
const top_exhibits = exhibits.slice(0, 5);
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>CSARCH2 Virtual Exhibit</title>
    </head>

    <body>
        <hgroup class="titleheading">
            <h1 class="title">ArchCities Virtual Exhibit</h1>
        </hgroup>

        <main class="judging">
            <div class="section__head">
                <h2 class="section__title">Top exhibits</h2>
            </div>
            <section class="section">
                {top_exhibits.map((exhibit) => ( <ExhibitCard exhibit={exhibit} />))}
            </section>
        </main>

        <footer>CSARCH2 Virtual Exhibit &mdash; "Computer Architecture is Forever"</footer>
    </body>
</html>
